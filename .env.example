# Copy to .env (git-ignored) and fill in. Shell environment variables take precedence.
OPENAI_API_KEY=

# Models (defaults shown)
# RELOCATION_RESEARCH_MODEL=gpt-5.4
# RELOCATION_SYNTHESIS_MODEL=gpt-5.4-mini

# Reasoning effort; leave unset to use each model's default (currently no reasoning tokens).
# RELOCATION_RESEARCH_EFFORT=low
# RELOCATION_SYNTHESIS_EFFORT=low

# ~half price, slower; good for bulk re-runs
# RELOCATION_SERVICE_TIER=flex

# Web search for categories that need current facts (cost, healthcare, travel, visa, tax)
# RELOCATION_WEB_SEARCH=1
# RELOCATION_WEB_CONTEXT_SIZE=low

# Optional contact for Overpass (beach accessibility script)
# RELOCATION_OVERPASS_CONTACT=
